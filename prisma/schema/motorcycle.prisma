model Motorcycle {
  id String @id @default(cuid())
  manufacturer String 
  model String
  year Int
  color String
  licensePlate String?
  vin String? @unique
  purchasedDate DateTime?
  purchasedPrice Decimal?
  powerHP Float?
  engineDisplacement Float?
  powrKw Float?
  fuelType FuelType
  imageUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User  @relation(fields: [userId], references: [id])
  userId String
  services Service[]
}

enum FuelType {
  PETROL
  ELECTRIC
}